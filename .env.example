# Server Port
PORT=5000

# MongoDB Database Connection URL
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stadiumDB?retryWrites=true&w=majority
# Or Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/stadiumDB

# Razorpay Test Mode Credentials
# Get keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# SMTP Email Configuration (Nodemailer)
# For Gmail, generate an App Password from Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL="JLN Stadium Box Office" <your-email@gmail.com>
